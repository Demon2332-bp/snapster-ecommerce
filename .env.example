# Gemini / hosting settings (provided by the hosting platform)
GEMINI_API_KEY=MY_GEMINI_API_KEY
APP_URL=MY_APP_URL

# Razorpay public Key ID may be exposed to checkout; secret values are server-only.
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME

# Firebase Admin SDK service-account JSON as a single-line JSON string.
# Generate from Firebase Console > Project settings > Service accounts.
FIREBASE_SERVICE_ACCOUNT_JSON=PASTE_ONE_LINE_SERVICE_ACCOUNT_JSON_HERE
FIREBASE_DATABASE_ID=ai-studio-snapsterpremiums-0f0a31f1-c628-41c1-894b-f705f1af7340

# Random long secret used only by the scheduled reservation cleanup request.
CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Optional public business contact configuration.
VITE_BUSINESS_PHONE=+91_REPLACE_ME
VITE_WHATSAPP_NUMBER=91_REPLACE_ME
VITE_INSTAGRAM_URL=https://www.instagram.com/REPLACE_ME
